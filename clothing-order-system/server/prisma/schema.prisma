// Clothing Order Management System — PostgreSQL schema (Prisma)
//
// IDs are 24-char lowercase-hex strings (ObjectId-shaped) generated by a
// database default. This preserves the existing API contract: responses expose
// them as `_id` (see src/utils/serialize.js) and all `isMongoId()` validators
// keep working unchanged.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Reusable ObjectId-shaped default. random 12 bytes -> 24 hex chars.
// (kept inline per-model via @default(dbgenerated(...)))

model User {
  id           String   @id @default(dbgenerated("substr(md5((random())::text || (clock_timestamp())::text), 1, 24)"))
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("manager") // admin | manager
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  productionLogs ProductionLog[]

  @@map("users")
}

model Customer {
  id             String   @id @default(dbgenerated("substr(md5((random())::text || (clock_timestamp())::text), 1, 24)"))
  tenantId       String   @default("default")
  name           String
  phone          String
  secondaryPhone String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders       Order[]
  measurements Measurement[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([phone])
  @@map("customers")
}

model Measurement {
  id           String   @id @default(dbgenerated("substr(md5((random())::text || (clock_timestamp())::text), 1, 24)"))
  customerId   String
  chest        Float?
  waist        Float?
  hip          Float?
  shoulder     Float?
  sleeveLength Float?
  inseam       Float?
  neck         Float?
  notes        String   @default("")
  recordedAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([recordedAt])
  @@map("measurements")
}

model Order {
  id                            String    @id @default(dbgenerated("substr(md5((random())::text || (clock_timestamp())::text), 1, 24)"))
  tenantId                      String    @default("default")
  orderId                       String    @unique
  customerId                    String
  groupCode                     String    @default("")
  requiredCompletionDate        DateTime
  estimatedProductionCompletion DateTime?
  productionStatus              String    @default("pending")
  priority                      String    @default("NORMAL")
  totalAgreedPrice              Float     @default(0)
  depositPaid                   Float     @default(0)
  totalRevenue                  Float     @default(0)
  barcodeValue                  String    @unique
  barcodeGeneratedAt            DateTime
  createdBy                     String?
  lastUpdatedBy                 String?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]

  @@index([tenantId])
  @@index([customerId])
  @@index([groupCode])
  @@index([productionStatus])
  @@map("orders")
}

model OrderItem {
  id                 String   @id @default(dbgenerated("substr(md5((random())::text || (clock_timestamp())::text), 1, 24)"))
  order              String // FK -> Order.id (kept named `order` to preserve API/query contract)
  orderId            String // denormalized business order id
  clothingCode       String
  clothingType       String
  fabricType         String
  color              String
  quantity           Int
  notes              String   @default("")
  neckType           String
  handType           String
  size               String
  measurements       Json?
  productionDays     Int      @default(3)
  lineTotal          Float    @default(0)
  unitPrice          Float    @default(0)
  difficultyLevel    Int      @default(3)
  barcodeValue       String   @unique
  barcodeGeneratedAt DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orderRel    Order            @relation(fields: [order], references: [id], onDelete: Cascade)
  images      OrderItemImage[]
  checkpoints StageCheckpoint[]
  assignments StaffAssignment[]

  @@index([order])
  @@index([orderId])
  @@index([clothingType])
  @@map("order_items")
}

model OrderItemImage {
  id          String   @id @default(dbgenerated("substr(md5((random())::text || (clock_timestamp())::text), 1, 24)"))
  orderItemId String
  imageUrl    String
  caption     String   @default("")
  uploadedAt  DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_images")
}

model ClothingTypeConfig {
  id                String   @id @default(dbgenerated("substr(md5((random())::text || (clock_timestamp())::text), 1, 24)"))
  key               String   @unique
  label             String
  stageSequence     String[]
  includesEmbroidery Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("clothing_type_configs")
}

model ProductionLog {
  id           String   @id @default(dbgenerated("substr(md5((random())::text || (clock_timestamp())::text), 1, 24)"))
  orderId      String
  mongoOrderId String?
  userId       String?
  action       String
  fromStatus   String?
  toStatus     String?
  notes        String   @default("")
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@map("production_logs")
}

model Staff {
  id         String   @id @default(dbgenerated("substr(md5((random())::text || (clock_timestamp())::text), 1, 24)"))
  tenantId   String   @default("default")
  name       String
  phone      String
  role       String
  status     String   @default("AVAILABLE")
  skillLevel Int      @default(3)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  skills      StaffSkill[]
  assignments StaffAssignment[]

  @@index([tenantId])
  @@index([active])
  @@map("staff")
}

model StaffSkill {
  id      String @id @default(dbgenerated("substr(md5((random())::text || (clock_timestamp())::text), 1, 24)"))
  staffId String
  stage   String

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, stage])
  @@index([staffId])
  @@map("staff_skills")
}

model StaffAssignment {
  id                String    @id @default(dbgenerated("substr(md5((random())::text || (clock_timestamp())::text), 1, 24)"))
  staffId           String
  orderItemId       String
  stage             String
  assignedAt        DateTime  @default(now())
  completedAt       DateTime?
  suggestedStaffId  String?
  followedSuggestion Boolean  @default(false)

  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([staffId, completedAt])
  @@index([orderItemId, stage, completedAt])
  @@map("staff_assignments")
}

model StageCheckpoint {
  id                  String    @id @default(dbgenerated("substr(md5((random())::text || (clock_timestamp())::text), 1, 24)"))
  orderItemId         String
  stage               String
  checkedInAt         DateTime
  checkedInByStaffId  String?
  checkedOutAt        DateTime?
  checkedOutByStaffId String?
  notes               String    @default("")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("stage_checkpoints")
}

model StatisticSnapshot {
  id              String   @id @default(dbgenerated("substr(md5((random())::text || (clock_timestamp())::text), 1, 24)"))
  key             String   @unique @default("global")
  totalOrders     Int      @default(0)
  completedOrders Int      @default(0)
  delayedOrders   Int      @default(0)
  totalRevenue    Float    @default(0)
  byStatus        Json     @default("{}")
  byClothingType  Json     @default("{}")
  lastComputedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("statistic_snapshots")
}
