# PostgreSQL connection string.
# Local dev example:
#   postgresql://oms:oms@127.0.0.1:5432/clothing_orders?schema=public
# Neon (production): use the POOLED connection string and require SSL, e.g.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/clothing_orders?sslmode=require
DATABASE_URL=postgresql://oms:oms@127.0.0.1:5432/clothing_orders?schema=public

# Optional. Neon *unpooled* host for prisma migrate deploy (no `-pooler` in the hostname).
# If unset, production start derives it from DATABASE_URL.
# DIRECT_URL=

# JWT secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Server port (Render sets PORT automatically)
PORT=4000

# Public URL of the API (used for image URLs in responses). No trailing slash.
# Example on Render: https://clothing-order-api.onrender.com
API_PUBLIC_URL=http://localhost:4000

# Comma-separated origins for CORS (your Vercel app URL + localhost for dev)
CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# Optional Cloudinary (unsigned preset) so garment photos survive Render deploys.
# Leave unset to keep local disk storage under server/uploads/ (dev fallback).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=

# Optional S3-compatible object storage (AWS S3, Cloudflare R2, MinIO).
# If bucket + access key + secret are set, uploads go here (takes precedence over Cloudinary).
# Local disk remains the fallback when these are unset, or if the remote upload fails.
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=                      # optional; set for R2/MinIO (path-style)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=               # optional public/CDN prefix for stored URLs
# Aliases AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION / AWS_S3_BUCKET also work.


